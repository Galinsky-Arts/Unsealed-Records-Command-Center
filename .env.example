# Server-side only. Never expose these to the browser bundle.
# Vite development proxy (npm run dev) injects the key into /api requests:
ENGINE_INTERNAL_URL=http://localhost:4000
ENGINE_READ_API_KEY=replace-with-the-scoped-engine-read-key-at-least-32-characters

# Production server (npm run build && npm start):
ENGINE_URL=https://your-engine.example
ENGINE_API_KEY=replace-with-the-scoped-engine-read-key-at-least-32-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local administrator fallback login (username defaults to admin). Minimum 16 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# APP_ORIGIN=https://your-command-center.example
# TRUST_PROXY=1
# SESSION_TTL_HOURS=8

# Optional OIDC login (all or none). The issuer must sign labelGrants into its RS256 ID token.
# BFF_ISSUER=https://issuer.example
# BFF_AUDIENCE=command-center
# BFF_JWKS_JSON={"keys":[...]}
# OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example/authorize
# OIDC_TOKEN_ENDPOINT=https://issuer.example/token
# OIDC_CLIENT_ID=command-center
# OIDC_REDIRECT_URI=https://your-command-center.example/auth/callback

# Write access, user management, imports and demo data (OFF until set). Use the same value as ENGINE_CONSOLE_KEY on the engine.
# ENGINE_WRITE_API_KEY=replace-with-the-engine-console-key-at-least-32-characters
# Signed QR campaign links (OFF until set; requires APP_ORIGIN).
# QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
